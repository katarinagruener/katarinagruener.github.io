---
import { navigation } from "@data/navigation";
---

<nav>

  <ul class="flex items-center gap-7">

    {
      navigation.map(item => (

        <li class="relative">

          {item.children ? (

            <button
              type="button"
              data-menu-trigger
              aria-haspopup="true"
              aria-expanded="false"
              class="
                relative
                flex
                items-center
                py-7
                text-[15px]
                font-semibold
                text-gray-700 dark:text-gray-300
                transition
                hover:text-primary
              "
            >

              {item.title}

              <span
                data-menu-underline
                class="
                  absolute
                  bottom-4
                  left-0
                  h-0.5
                  w-full
                  scale-x-0
                  bg-primary
                  transition-transform
                  duration-200
                  origin-left
                "
              />

            </button>

          ) : (

            <a
              href={item.href}
              class="
                relative
                flex
                items-center
                py-7
                text-[15px]
                font-semibold
                text-gray-700 dark:text-gray-300
                transition
                hover:text-primary
              "
            >

              {item.title}

            </a>

          )}



          {
            item.children && (

              <div
                data-menu-panel
                class="
                  invisible
                  absolute
                  left-0
                  top-full
                  z-50
                  min-w-[260px]
                  border-t
                  border-gray-100 dark:border-gray-800
                  bg-white dark:bg-gray-900
                  py-1
                  shadow-sm
                  opacity-0
                  translate-y-1
                  transition-all
                  duration-200
                "
              >

                {
                  item.children.map(child => (

                    <a
                      href={child.href}
                      class="
                        block
                        px-5
                        py-2
                        text-sm
                        text-gray-700 dark:text-gray-300
                        transition
                        hover:bg-gray-50 hover:dark:bg-gray-800
                        hover:text-primary
                      "
                    >
                      {child.title}
                    </a>

                  ))
                }

              </div>

            )
          }


        </li>

      ))
    }

  </ul>

</nav>

<script>

// Dropdowns are driven from JS (not pure CSS :hover) so aria-expanded stays
// accurate and every trigger is openable via keyboard: Tab focuses the
// button, Enter/Space opens it (native <button> behavior), Tab again moves
// into the panel's links, and Escape or focus leaving the item closes it.
const triggers = document.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]");

function panelOf(trigger: HTMLButtonElement) {
  return trigger.nextElementSibling as HTMLElement | null;
}

function open(trigger: HTMLButtonElement) {
  trigger.setAttribute("aria-expanded", "true");
  trigger.querySelector("[data-menu-underline]")?.classList.add("scale-x-100");
  panelOf(trigger)?.classList.remove("invisible", "opacity-0", "translate-y-1");
}

function close(trigger: HTMLButtonElement) {
  trigger.setAttribute("aria-expanded", "false");
  trigger.querySelector("[data-menu-underline]")?.classList.remove("scale-x-100");
  panelOf(trigger)?.classList.add("invisible", "opacity-0", "translate-y-1");
}

function closeAll(except?: HTMLButtonElement) {
  triggers.forEach((trigger) => {
    if (trigger !== except) close(trigger);
  });
}

triggers.forEach((trigger) => {

  const item = trigger.closest("li");

  // Not a toggle: a real mouse click is always preceded by the mouseenter
  // handler below, which already opens this item — a naive toggle would read
  // aria-expanded="true" at that point and immediately close what hover just
  // opened, making the dropdown unclickable with a mouse. Click only needs to
  // guarantee "open" (mouseleave/Escape/outside-click handle closing); it's
  // what actually opens the menu for keyboard (Enter/Space) and touch, where
  // there's no preceding hover.
  trigger.addEventListener("click", () => {
    closeAll(trigger);
    open(trigger);
  });

  item?.addEventListener("mouseenter", () => {
    closeAll(trigger);
    open(trigger);
  });

  item?.addEventListener("mouseleave", () => {
    close(trigger);
  });

  item?.addEventListener("focusout", (event) => {
    const next = (event as FocusEvent).relatedTarget as Node | null;
    if (!next || !item.contains(next)) {
      close(trigger);
    }
  });

});

document.addEventListener("keydown", (event) => {

  if (event.key !== "Escape") return;

  const openTrigger = Array.from(triggers).find(
    (trigger) => trigger.getAttribute("aria-expanded") === "true"
  );

  if (openTrigger) {
    close(openTrigger);
    openTrigger.focus();
  }

});

document.addEventListener("click", (event) => {

  const target = event.target as Node;

  const clickedInsideAMenu = Array.from(triggers).some((trigger) =>
    trigger.closest("li")?.contains(target)
  );

  if (!clickedInsideAMenu) closeAll();

});

</script>
