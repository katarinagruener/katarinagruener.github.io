{isBrand ? (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.8"
    stroke="currentColor"
    class={className}
    aria-hidden="true"
  >
    {paths[name].map((d) => (
      <path stroke-linecap="round" stroke-linejoin="round" d={d} />
    ))}
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="currentColor"
    viewBox="0 -960 960 960"
    class={className}
    aria-hidden="true"
  >
    {paths[name].map((d) => (
      <path d={d} />
    ))}
  </svg>
)}
