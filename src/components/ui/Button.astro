---
interface Props {
  href?: string;
  size?: "sm" | "md" | "lg";
  download?: boolean;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  href,
  size = "sm",
  download = false,
  target,
  rel,
  type = "button",
  class: className
} = Astro.props;

const sizeClasses = {
  sm: "px-4 py-2",
  md: "px-5 py-3",
  lg: "px-6 py-3"
}[size];

const baseClasses = "inline-flex rounded-xl bg-primary text-sm font-semibold text-white transition hover:bg-primary-dark";
---

{href ? (
  <a
    href={href}
    target={target}
    rel={rel}
    download={download}
    class:list={[baseClasses, sizeClasses, className]}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class:list={[baseClasses, sizeClasses, className]}
  >
    <slot />
  </button>
)}
