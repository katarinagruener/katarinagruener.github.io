---
import Icon from "@components/ui/Icon.astro";
import { NEWS_CATEGORIES, type NewsCategory } from "@data/newsCategories";
import { getAttachmentType } from "@lib/newsAttachment";
import { getDocumentDate } from "@lib/documentDate";

interface Props {
  slug: string;
  title: string;
  description?: string[];
  href?: string;
  file?: string;
  cover?: string;
  category?: NewsCategory;
}

const { slug, title, description, href, file, cover, category } = Astro.props;

const attachmentType = getAttachmentType(file);
const image = cover ?? (attachmentType === "image" ? file : undefined);

const categoryMeta = category ? NEWS_CATEGORIES[category] : undefined;

const iconName = categoryMeta?.icon ?? (attachmentType === "pdf" ? "document" : href ? "link" : "image");

const placeholderClasses = categoryMeta?.badgeClasses ?? "bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500";

const badgeClasses = categoryMeta?.badgeClasses ?? "bg-primary/10 text-primary";

const date = getDocumentDate(file);
const formattedDate = date.toLocaleDateString("de-DE", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric"
});
---

<a
  href={`/meldungen/${slug}`}
  class="
    group
    flex
    gap-4
    rounded-2xl
    bg-white dark:bg-gray-900
    p-4
    shadow-sm
    transition
    hover:-translate-y-1
    hover:shadow-lg
    sm:gap-6
    sm:p-5
  "
>
  <div
    class:list={[
      "aspect-square w-24 shrink-0 overflow-hidden rounded-xl sm:w-36 sm:aspect-[4/3] md:w-48",
      image ? "bg-gray-100 dark:bg-gray-800" : placeholderClasses
    ]}
  >
    {image ? (
      <img
        src={image}
        alt={title}
        class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full items-center justify-center">
        <Icon name={iconName} class="h-8 w-8 sm:h-10 sm:w-10" />
      </div>
    )}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      {categoryMeta ? (
        <span
          class:list={[
            "inline-flex w-fit items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold transition",
            badgeClasses
          ]}
        >
          <Icon name={categoryMeta.icon} class="h-3.5 w-3.5" /> {categoryMeta.label}
        </span>
      ) : <span />}

      <span class="shrink-0 text-xs text-gray-400 dark:text-gray-500">{formattedDate}</span>
    </div>

    <h3 class="line-clamp-2 font-bold leading-snug text-gray-900 dark:text-gray-100 transition group-hover:text-primary sm:text-lg">
      {title}
    </h3>

    {description?.[0] && (
      <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        {description[0]}
      </p>
    )}
  </div>
</a>
