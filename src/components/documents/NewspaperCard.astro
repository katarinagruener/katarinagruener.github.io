---
import Button from "@components/ui/Button.astro";

interface Props {

  title: string;

  slug?: string;

  file: string;

  cover?: string;

}


const {
  title,
  slug,
  file,
  cover
} = Astro.props;

---


<article
class="
group
overflow-hidden
rounded-2xl
border
border-gray-200 dark:border-gray-700
bg-white dark:bg-gray-900
shadow-sm
transition
hover:shadow-md
[&:has(:target)]:border-primary [&:has(:target)]:ring-2 [&:has(:target)]:ring-primary/50
"
>


<div
class="
aspect-[3/4]
overflow-hidden
bg-gray-100 dark:bg-gray-800
"
>


{
cover
?
<img
src={cover}
alt={title}
class="
h-full
w-full
object-cover
transition-transform
duration-300
group-hover:scale-110
"
/>

:

<div
class="
flex
h-full
items-center
justify-center
text-gray-600 dark:text-gray-400
"
>
Keine Vorschau
</div>

}


</div>





<div
class="
p-3
sm:p-5
"
>


<h3
id={slug && `card-${slug}`}
class="
scroll-mt-24
text-sm
font-semibold
leading-snug
text-gray-900 dark:text-gray-100
sm:text-lg
"
>
{title}
</h3>




<Button href={file} download class="mt-3 w-full justify-center text-xs sm:mt-5 sm:w-auto sm:text-sm">
PDF herunterladen
</Button>


</div>



</article>