---
import type { CollectionEntry } from "astro:content";

import Icon from "@components/ui/Icon.astro";
import ObfuscatedEmail from "@components/ui/ObfuscatedEmail.astro";

type Person = CollectionEntry<"people">["data"];

interface Props {
  person: Person;
}

const {
  person
} = Astro.props;

---

<article
  class="
    rounded-2xl
    border
    border-gray-200 dark:border-gray-700
    bg-white dark:bg-gray-900
    p-6
    shadow-sm
    transition
    hover:shadow-md
  "
>


<div
  class="
    flex
    items-start
    gap-5
  "
>


<div
  class="
    flex
    h-24
    w-24
    shrink-0
    items-center
    justify-center
    overflow-hidden
    rounded-full
    bg-gray-100 dark:bg-gray-800
  "
>

{
  person.photo
    ?
    <img
      src={person.photo}
      alt={person.name}
      class="h-full w-full object-cover"
    />
    :
    <Icon name="user" class="h-10 w-10 text-gray-400 dark:text-gray-500" />
}


</div>



<div
class="
min-h-44
"
>


<h2
class="
text-xl
font-semibold
text-gray-900 dark:text-gray-100
"
>
{person.name}
</h2>


{
person.badge &&
<span
  class="
    mt-2
    inline-block
    rounded-full
    bg-blue-50
    px-3
    py-1
    text-xs
    font-semibold
    text-primary
  "
>
  {person.badge}
</span>
}


{
person.role &&
<p
  class="
    mt-1
    text-sm
    leading-relaxed
    text-gray-600 dark:text-gray-400
  "
>
  {person.role}
</p>
}


{
person.group &&
<p
class="
mt-2
text-sm
text-gray-600 dark:text-gray-400
"
>
{person.group}
</p>
}


{
person.organization &&
<p
class="
mt-2
text-sm
text-gray-600 dark:text-gray-400
"
>
{person.organization}
</p>
}


</div>


</div>



<div
class="
mt-6
border-t
border-gray-100 dark:border-gray-800
pt-5
space-y-2
text-sm
text-gray-700 dark:text-gray-300
"
>


{
person.address &&
<p class="flex items-center gap-2">
<Icon name="location" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" /> {person.address}
</p>
}


{
person.phone &&
<div>

{
person.phone.map(phone => (

<p class="flex items-center gap-2">
<Icon name="phone" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" /> {phone}
</p>

))
}

</div>
}


{
person.mobile &&
<div>

{
person.mobile.map(phone => (

<p class="flex items-center gap-2">
<Icon name="mobile" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" /> {phone}
</p>

))
}

</div>
}



{
person.email &&
<div>

{
person.email.map(email => (

<p class="flex items-center gap-2">
<Icon name="email" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" />
<ObfuscatedEmail email={email} class="text-primary hover:underline" />
</p>

))
}

</div>
}



</div>


</article>