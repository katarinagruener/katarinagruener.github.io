---
import { getCollection } from "astro:content";

import Icon from "@components/ui/Icon.astro";
import NewsCard from "@components/news/NewsCard.astro";

const news = (await getCollection("meldungen"))
  .map((entry) => ({ ...entry.data, slug: entry.id }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4);
---

<div>


  <!-- Header -->

  <div class="mb-8 flex items-end justify-between">

    <div>

      <h2
        class="
          text-3xl
          font-bold
          text-gray-900 dark:text-gray-100
        "
      >
        Meldungen
      </h2>


      <p
        class="
          mt-2
          text-gray-600 dark:text-gray-400
        "
      >
        Neuigkeiten und wichtige Informationen
      </p>

    </div>


    <a
      href="/meldungen"
      class="
        flex
        shrink-0
        items-center
        gap-1
        text-sm
        font-semibold
        text-primary-dark
        hover:underline
        dark:text-primary
      "
    >
      Alle Meldungen <Icon name="arrow-right" class="h-4 w-4" />
    </a>


  </div>



  <!-- News cards -->

  <div
    class="
      flex
      flex-col
      gap-4
    "
  >

    {
      news.map((item) => (
        <NewsCard {...item} />
      ))
    }

  </div>


</div>
