---
import { getEntry } from "astro:content";

import Icon from "@components/ui/Icon.astro";

const wlanHotspotCount = (await getEntry("ueber-uns", "main"))?.data.wlanHotspots.length ?? 0;
const ladesaeulenCount = (await getEntry("ladesaeulen", "main"))?.data.standorte.length ?? 0;
---

<div class="flex flex-col">

  <div class="flex flex-col gap-4">

  <a
    href="https://whatsapp.com/channel/0029VbBpfxm5fM5bkgZKDC2Z"
    target="_blank"
    rel="noopener noreferrer"
    class="
      flex
      items-center
      gap-3
      rounded-2xl
      bg-gray-50 dark:bg-gray-800
      p-4
      transition
      hover:bg-gray-100 hover:dark:bg-gray-800
    "
  >
    <span
      class="
        flex
        h-10
        w-10
        shrink-0
        items-center
        justify-center
        rounded-full
        bg-[#25D366]/10
        text-[#25D366]
      "
    >
      <Icon name="whatsapp" class="h-5 w-5" />
    </span>

    <span class="flex flex-col">
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100">WhatsApp-Kanal</span>
      <span class="text-sm text-gray-600 dark:text-gray-400">Immer aktuell informiert bleiben</span>
    </span>
  </a>


  <a
    href="/kultur/veranstaltungen"
    class="
      flex
      items-center
      gap-3
      rounded-2xl
      bg-gray-50 dark:bg-gray-800
      p-4
      transition
      hover:bg-gray-100 hover:dark:bg-gray-800
    "
  >
    <span
      class="
        flex
        h-10
        w-10
        shrink-0
        items-center
        justify-center
        rounded-full
        bg-primary/10
        text-primary
      "
    >
      <Icon name="calendar" class="h-5 w-5" />
    </span>

    <span class="flex flex-col">
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100">Veranstaltungen</span>
      <span class="text-sm text-gray-600 dark:text-gray-400">Termine und Feste im Überblick</span>
    </span>
  </a>


  <a
    href="/gemeinde/see-kurier"
    class="
      flex
      items-center
      gap-3
      rounded-2xl
      bg-gray-50 dark:bg-gray-800
      p-4
      transition
      hover:bg-gray-100 hover:dark:bg-gray-800
    "
  >
    <span
      class="
        flex
        h-10
        w-10
        shrink-0
        items-center
        justify-center
        rounded-full
        bg-accent/10
        text-accent
      "
    >
      <Icon name="document" class="h-5 w-5" />
    </span>

    <span class="flex flex-col">
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100">See-Kurier</span>
      <span class="text-sm text-gray-600 dark:text-gray-400">Alle Ausgaben unserer Gemeindezeitung</span>
    </span>
  </a>


  <a
    href="/ueber-uns#wlan"
    class="
      flex
      items-center
      gap-3
      rounded-2xl
      bg-gray-50 dark:bg-gray-800
      p-4
      transition
      hover:bg-gray-100 hover:dark:bg-gray-800
    "
  >
    <span
      class="
        flex
        h-10
        w-10
        shrink-0
        items-center
        justify-center
        rounded-full
        bg-emerald-500/10
        text-emerald-600
      "
    >
      <Icon name="wifi" class="h-5 w-5" />
    </span>

    <span class="flex flex-col">
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100">Öffentliches WLAN</span>
      <span class="text-sm text-gray-600 dark:text-gray-400">An {wlanHotspotCount} {wlanHotspotCount === 1 ? "Standort" : "Standorten"} in der Gemeinde surfen</span>
    </span>
  </a>


  <a
    href="/leben-freizeit/einkaufen#ladesaeulen"
    class="
      flex
      items-center
      gap-3
      rounded-2xl
      bg-gray-50 dark:bg-gray-800
      p-4
      transition
      hover:bg-gray-100 hover:dark:bg-gray-800
    "
  >
    <span
      class="
        flex
        h-10
        w-10
        shrink-0
        items-center
        justify-center
        rounded-full
        bg-primary/10
        text-primary
      "
    >
      <Icon name="battery" class="h-5 w-5" />
    </span>

    <span class="flex flex-col">
      <span class="text-sm font-bold text-gray-900 dark:text-gray-100">E-Ladesäulen</span>
      <span class="text-sm text-gray-600 dark:text-gray-400">{ladesaeulenCount} öffentliche{ladesaeulenCount === 1 ? "r" : ""} Ladepunkt{ladesaeulenCount === 1 ? "" : "e"} in der Gemeinde</span>
    </span>
  </a>

  </div>

</div>
