---
import heroImage from "@assets/images/hero/seddiner-see.jpg";
---

<section
  class="
    relative
    overflow-hidden
  "
>


  <img
    src={heroImage.src}
    alt="Seddiner See"
    class="
      absolute
      inset-0
      h-full
      w-full
      object-cover
    "
  />


  <!-- Overlay -->

  <div
    class="
      absolute
      inset-0
      bg-black/35
    "
  ></div>



  <div
    class="
      relative
      container
      flex
      min-h-[480px]
      items-center
    "
  >


    <div
      class="
        max-w-xl
        text-white
      "
    >


      <h1
        class="
          mb-6
          text-4xl
          font-bold
          leading-tight
          md:text-6xl
        "
      >
        Willkommen
        <br />
        am Seddiner See
      </h1>



      <p
        class="
          mb-8
          max-w-lg
          text-lg
          leading-relaxed
          text-white/90
        "
      >
        Natur erleben.
        <br />
        Gemeinschaft gestalten.
      </p>



      <div
        class="
          flex
          flex-wrap
          gap-4
        "
      >


        <a
          href="/ueber-uns"
          class="
            rounded-full
            bg-white
            px-6
            py-3
            text-sm
            font-semibold
            text-slate-900
            transition
            hover:bg-gray-100
            dark:bg-gray-900
            dark:text-gray-100
            dark:hover:bg-gray-800
          "
        >
          Über uns
        </a>



        <a
          href="/kontakt"
          class="
            rounded-full
            border
            border-white
            bg-transparent
            px-6
            py-3
            text-sm
            font-semibold
            text-white
            transition
            hover:bg-white/10
            md:hidden
          "
        >
          Kontakt
        </a>



        <a
          href="/verwaltung"
          class="
            hidden
            rounded-full
            border
            border-white
            bg-transparent
            px-6
            py-3
            text-sm
            font-semibold
            text-white
            transition
            hover:bg-white/10
            md:inline-block
          "
        >
          Verwaltung
        </a>


      </div>


    </div>


  </div>


</section>