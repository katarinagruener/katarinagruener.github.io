---
import Icon from "@components/ui/Icon.astro";
---

<dialog
  id="event-modal"
  class="fixed left-1/2 top-1/2 m-0 w-[calc(100%-2rem)] max-w-lg -translate-x-1/2 -translate-y-1/2 rounded-2xl border-0 bg-white p-0 text-gray-900 shadow-xl backdrop:bg-slate-950/60 dark:bg-gray-900 dark:text-gray-100"
>

  <div class="max-h-[85vh] overflow-y-auto">

    <div id="event-modal-image-wrap" class="hidden">
      <img id="event-modal-image" alt="" class="h-56 w-full object-cover" />
    </div>

    <div class="relative p-6">

      <button
        type="button"
        data-event-modal-close
        aria-label="Schließen"
        class="absolute right-4 top-4 flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 transition hover:bg-gray-200 dark:hover:bg-gray-700"
      >
        <Icon name="close" class="h-4 w-4" />
      </button>

      <h2 id="event-modal-title" class="pr-10 text-xl font-bold text-gray-900 dark:text-gray-100"></h2>

      <div class="mt-4 space-y-3 text-sm text-gray-700 dark:text-gray-300">

        <p>
          <span class="font-semibold text-gray-900 dark:text-gray-100">Beginn</span>
          <br />
          <span id="event-modal-start"></span>
        </p>

        <p id="event-modal-end-row" class="hidden">
          <span class="font-semibold text-gray-900 dark:text-gray-100">Ende</span>
          <br />
          <span id="event-modal-end"></span>
        </p>

        <p id="event-modal-description" class="hidden"></p>

        <div id="event-modal-location">
          <p class="font-semibold text-gray-900 dark:text-gray-100">Veranstaltungsort</p>
          <p id="event-modal-location-name"></p>
          <p id="event-modal-location-address" class="text-gray-600 dark:text-gray-400"></p>
        </div>

        <div id="event-modal-admission" class="hidden space-y-1 font-medium text-primary-dark dark:text-primary"></div>

      </div>

    </div>

  </div>

</dialog>
