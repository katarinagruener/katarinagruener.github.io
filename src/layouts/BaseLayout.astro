---
import Header from "@components/layout/Header.astro";
import Footer from "@components/layout/Footer.astro";
import BackToTop from "@components/ui/BackToTop.astro";

import { site } from "@data/site";

import "@styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = site.description,
  image = "/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="de">
<head>

<script is:inline>
  (function () {
    const stored = localStorage.getItem("theme");
    const isDark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.classList.toggle("dark", isDark);
  })();
</script>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1"
/>

<title>
  {title}
</title>

<meta
  name="description"
  content={description}
/>

<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="de_DE" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="module" is:inline>
  window.__pagefind = import("/pagefind/pagefind.js")
    .then(async (mod) => {
      await mod.init();
      // German compound words (e.g. "Kinderfeuerwehr", "Kiefernweg") otherwise
      // fuzzy-match short queries like "kita" and can outrank real matches —
      // raising termSimilarity penalizes matches that are much longer than
      // the search term. See https://pagefind.app/docs/ranking/
      await mod.options({ ranking: { termSimilarity: 5 } });
      return mod;
    })
    .catch(() => null);
</script>

</head>

<body>

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-xl focus:bg-primary focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg"
>
  Zum Inhalt springen
</a>

<Header />

<main id="main-content" tabindex="-1" data-pagefind-body>
  <slot />
</main>

<Footer />

<BackToTop />

</body>
</html>