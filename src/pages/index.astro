import QuickLinksPreview from "@components/sections/QuickLinksPreview.astro";
import DokumentenportalPreview from "@components/sections/DokumentenportalPreview.astro";
---

<BaseLayout title="Gemeinde Seddiner See">

<Hero />

<section class="py-16">
  <div class="container">
    <NewsPreview />
    <div class="mt-16 grid gap-10 lg:grid-cols-2">
