---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
---

<BaseLayout
  title="Links"
  description="Weiterführende Links der Gemeinde Seddiner See"
>


<section class="py-12">


<div class="container">


<Breadcrumbs items={[{ label: "Links" }]} />


<h1
  class="
    text-4xl
    font-bold
    text-gray-900 dark:text-gray-100
  "
>
Links
</h1>


<p class="mt-4 max-w-2xl text-gray-700 dark:text-gray-300">
Diese Seite befindet sich im Aufbau. Hier finden Sie in Kürze weiterführende Links zu Behörden und Partnern der Gemeinde.
</p>


</div>


</section>


</BaseLayout>
