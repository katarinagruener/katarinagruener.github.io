---
import type { GetStaticPathsOptions, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import Pagination from "@components/ui/Pagination.astro";
import NewsCard from "@components/news/NewsCard.astro";
import NewsCategoryFilter from "@components/news/NewsCategoryFilter.astro";

import { NEWS_CATEGORIES } from "@data/newsCategories";
import type { NewsCategory } from "@data/newsCategories";
import { getDocumentDate } from "@lib/documentDate";
import { getPageHero } from "@lib/pageHero";

type NewsItem = CollectionEntry<"meldungen">["data"] & { slug: string };

interface Props {
  page: Page<NewsItem>;
  usedCategories: NewsCategory[];
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const news = (await getCollection("meldungen"))
    .map((entry) => ({ data: { ...entry.data, slug: entry.id }, date: getDocumentDate(entry.data.file) }))
    .sort((a, b) => b.date.getTime() - a.date.getTime())
    .map((item) => item.data);

  const usedCategories = (Object.keys(NEWS_CATEGORIES) as NewsCategory[])
    .filter((key) => news.some((item) => item.category === key));

  return paginate(news, { pageSize: 12, props: { usedCategories } });
}

const { page, usedCategories } = Astro.props as Props;
const hero = await getPageHero("meldungen");
---

<BaseLayout
  title="Meldungen"
  description="Aktuelle Meldungen der Gemeinde Seddiner See"
>


<section class="py-12">


<div class="container">


<Breadcrumbs items={[{ label: "Meldungen" }]} />


<PageHero
  title={hero?.title ?? "Meldungen"}
  subtitle={hero?.subtitle ?? "Neuigkeiten und wichtige Informationen"}
  images={hero?.images ?? []}
  gradient
/>


<NewsCategoryFilter categories={usedCategories} active="all" />


<div
  class="
    mt-8
    flex
    flex-col
    gap-4
  "
>

{
  page.data.map((item) => (
    <NewsCard {...item} />
  ))
}

</div>


<Pagination page={page} />


</div>


</section>


</BaseLayout>
