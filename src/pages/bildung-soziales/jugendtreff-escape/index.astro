---
import { getEntry } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import Icon from "@components/ui/Icon.astro";
import EmployeeCard from "@components/administration/EmployeeCard.astro";

import { getPageHero } from "@lib/pageHero";

const riaSchicks = await getEntry("verwaltung-mitarbeiter", "11-ria-schicks");
const winnieList = await getEntry("verwaltung-mitarbeiter", "12-winnie-list");
const hero = await getPageHero("jugendtreff-escape");
const hasImage = (hero?.images?.length ?? 0) > 0;

const angebote = [
  "Tischkicker, Billard, Dart & Gesellschaftsspiele",
  "Gemeinsames Kochen und Essen",
  "Turniere, kreative Projekte & Aktionen",
  "Ferienprogramm mit Ausflügen, Fahrten und Sport",
  "Freies Spielen in der angrenzenden Turnhalle",
  "Zocken an der Konsole (nach Absprache)"
];
---


<BaseLayout
  title='Jugendtreff "Escape"'
  description="Offener Jugendtreff für Kinder und Jugendliche in der Gemeinde Seddiner See"
>


<section class:list={["pb-12", !hasImage && "pt-6"]}>


<div class="container">








<div class:list={["flex flex-col gap-4", hasImage && "flex-col-reverse"]}>

<Breadcrumbs items={[{ label: 'Jugendtreff „Escape"' }]} />

<PageHero
  title={hero?.title ?? 'Jugendtreff „Escape"'}
  subtitle={hero?.subtitle ?? "Du bist zwischen 10 und 16 Jahre alt? Dann bist du bei uns genau richtig!"}
  images={hero?.images ?? []}
  gradient
  fullBleed={hasImage}
/>

</div>


<div class="mt-6 grid gap-10 lg:grid-cols-3">

<div class="space-y-8 lg:col-span-2">

<p class="leading-relaxed text-gray-700 dark:text-gray-300">
Der Jugendtreff „Escape" ist ein offenes Angebot für alle Kinder und Jugendlichen aus Seddiner See und Umgebung. Der Eintritt ist frei, der Besuch freiwillig. Du kommst, wenn du Lust hast!
</p>

<div>
  <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Was geht bei uns?</h2>
  <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
    Im Offenen Treff kannst du einfach mit deinen Freunden abhängen, chillen, Musik hören oder spielen. Bei uns ist immer was los:
  </p>
  <ul class="mt-4 grid gap-2 sm:grid-cols-2">
  {
    angebote.map((item) => (
      <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
        {item}
      </li>
    ))
  }
  </ul>
  <p class="mt-4 leading-relaxed text-gray-700 dark:text-gray-300">
    Ob Sport, Spiele oder einfach nur entspannen, du entscheidest, was du brauchst.
  </p>
</div>

<div>
  <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Für die Älteren</h2>
  <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
    Auch wenn du schon älter bist, bleiben wir am Start: Projekte, gezielte Angebote oder Hilfe bei der Berufsorientierung, wir begleiten dich auf deinem Weg. Sprich uns einfach an!
  </p>
</div>

<div>
  <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Raum zum Mitgestalten</h2>
  <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
    Der Jugendtreff ist euer Raum! Wir freuen uns, wenn ihr euch einbringt, mitredet, mitmacht. Hier könnt ihr sein, wie ihr seid und werdet gehört.
  </p>
</div>

<div>
  <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100">Eltern willkommen</h2>
  <p class="mt-3 leading-relaxed text-gray-700 dark:text-gray-300">
    Auch Eltern sind bei uns immer herzlich willkommen. Bei Fragen, Sorgen oder einfach zum Kennenlernen, unsere Tür steht offen. Wir unterstützen, beraten und nehmen bei Bedarf auch Kontakt auf, wenn es mal schwierig wird.
  </p>
</div>

</div>


<div class="space-y-6">

  <div class="rounded-2xl bg-gray-50 dark:bg-gray-800 p-6">
    <h2 class="font-bold text-gray-900 dark:text-gray-100">Auf einen Blick</h2>

    <p class="mt-4 flex items-start gap-2 text-sm text-gray-700 dark:text-gray-300">
      <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-gray-500 dark:text-gray-400" />
      <span>
        Hans-Beimler-Str. 17<br />
        14554 Seddiner See<br />
        Im Untergeschoss der Grundschule
      </span>
    </p>

    <ul class="mt-4 space-y-2.5 text-sm text-gray-700 dark:text-gray-300">
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
        Für Kinder und Jugendliche von 10 bis 16 Jahren
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
        Eintritt frei, Besuch freiwillig
      </li>
      <li class="flex items-start gap-2">
        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
        Offen für alle aus Seddiner See und Umgebung
      </li>
    </ul>

    <a
      href="https://www.instagram.com/jugendtreff_escape14554/"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-dark hover:underline dark:text-primary"
    >
      <Icon name="instagram" class="h-5 w-5" /> @jugendtreff_escape14554
    </a>
  </div>

  <div class="border-l-4 border-accent pl-4">
    <h2 class="font-bold text-gray-900 dark:text-gray-100">Achtung Ferienzeit!</h2>
    <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
      In den Ferien können sich unsere Öffnungszeiten ändern. Schaut bitte auf unsere Aushänge oder checkt die Infos auf Instagram
    </p>
  </div>

</div>

</div>


<div class="mt-14">

<h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Noch Fragen?</h2>
<p class="mt-2 max-w-2xl text-gray-700 dark:text-gray-300">
Dann schaut einfach vorbei oder meldet euch bei uns:
</p>

<div class="mt-6 grid gap-6 sm:grid-cols-2">
  {riaSchicks && <EmployeeCard employee={riaSchicks.data} slug={riaSchicks.id} />}
  {winnieList && <EmployeeCard employee={winnieList.data} slug={winnieList.id} />}
</div>

</div>


</div>


</section>


</BaseLayout>
