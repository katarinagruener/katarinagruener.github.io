---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import Icon from "@components/ui/Icon.astro";
import PhotoCarousel from "@components/ui/PhotoCarousel.astro";
import PhotoLightbox from "@components/ui/PhotoLightbox.astro";
import HoursList from "@components/ui/HoursList.astro";

import { getPageHero } from "@lib/pageHero";

const einrichtungen = (await getCollection("kitas")).map((entry) => ({ ...entry.data, slug: entry.id }));
const hero = await getPageHero("kitas");
const hasImage = (hero?.images?.length ?? 0) > 0;
---


<BaseLayout
  title="Kindertagesstätten und Hort"
  description="Kitas und Hort in der Gemeinde Seddiner See"
>


<section class:list={["pb-12", !hasImage && "pt-6"]}>


<div class="container">








<div class:list={["flex flex-col gap-4", hasImage && "flex-col-reverse"]}>

<Breadcrumbs items={[{ label: "Kindertagesstätten und Hort" }]} />

<PageHero
  title={hero?.title ?? "Kindertagesstätten und Hort"}
  subtitle={hero?.subtitle ?? "Betreuungsangebote für Kinder und Schulkinder"}
  images={hero?.images ?? []}
  gradient
  fullBleed={hasImage}
/>

</div>


<div class="mt-8 space-y-10">

{
  einrichtungen.map((einrichtung, einrichtungIndex) => (
    <div class="overflow-hidden rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 [&:has(:target)]:border-primary [&:has(:target)]:ring-2 [&:has(:target)]:ring-primary/50">

      {einrichtung.images && (
        <PhotoCarousel
          id={`kita-${einrichtungIndex}`}
          images={einrichtung.images.map((src) => ({ src, alt: einrichtung.name }))}
        />
      )}

      <div class="p-8">

      <div class="flex flex-col items-start gap-3 sm:flex-row sm:gap-5">

        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
          <Icon name="kita" class="h-6 w-6" />
        </span>

        <div>
          <h2 id={`card-${einrichtung.slug}`} class="scroll-mt-24 text-2xl font-bold text-gray-900 dark:text-gray-100">{einrichtung.name}</h2>
          {einrichtung.ortsteil && (
            <p class="mt-1 text-gray-600 dark:text-gray-400">Ortsteil {einrichtung.ortsteil}</p>
          )}
        </div>

      </div>

      {einrichtung.highlights && (
        <div class="mt-5 flex flex-wrap gap-2">
          {einrichtung.highlights.map((highlight) => (
            <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
              {highlight}
            </span>
          ))}
        </div>
      )}

      <div class="mt-6 grid gap-x-8 gap-y-3 border-t border-gray-100 dark:border-gray-800 pt-6 text-sm text-gray-700 dark:text-gray-300 sm:grid-cols-2">

        <p class="flex items-start gap-2">
          <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" />
          <span>
            {einrichtung.address.split(", ").map((line, index, lines) => (
              <>
                {line}
                {index < lines.length - 1 && <br />}
              </>
            ))}
          </span>
        </p>

        <div class="space-y-1">

          {einrichtung.phone?.map((phone) => (
            <p class="flex items-center gap-2">
              <Icon name="phone" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" /> {phone}
            </p>
          ))}

          {einrichtung.mobile?.map((mobile) => (
            <p class="flex items-center gap-2">
              <Icon name="mobile" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" /> {mobile}
            </p>
          ))}

        </div>

        {einrichtung.email && (
          <p class="flex items-center gap-2">
            <Icon name="email" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" />
            <a href={`mailto:${einrichtung.email}`} class="hover:text-primary">{einrichtung.email}</a>
          </p>
        )}

        {einrichtung.website && (
          <p class="flex items-center gap-2">
            <Icon name="link" class="h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" />
            <a href={einrichtung.website.startsWith("http") ? einrichtung.website : `https://${einrichtung.website}`} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
              {einrichtung.website}
            </a>
          </p>
        )}

      </div>

      {einrichtung.hours && (
        <div class="mt-4 flex items-start gap-2 text-sm text-gray-600 dark:text-gray-400">
          <Icon name="calendar" class="mt-0.5 h-4 w-4 shrink-0 text-gray-400 dark:text-gray-500" />
          <HoursList hours={einrichtung.hours} />
        </div>
      )}

      {einrichtung.description && (
        <details class="group mt-6 border-t border-gray-100 dark:border-gray-800 pt-6">
          <summary class="flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:text-primary">
            Pädagogisches Konzept
            <Icon name="arrow-up" class="h-4 w-4 rotate-180 transition group-open:rotate-0" />
          </summary>
          <div class="mt-4 max-w-3xl space-y-3 text-gray-700 dark:text-gray-300">
            {einrichtung.description.map((paragraph) => (<p>{paragraph}</p>))}
          </div>
        </details>
      )}

      {einrichtung.contacts && (
        <div class="mt-6 grid gap-4 border-t border-gray-100 dark:border-gray-800 pt-6 sm:grid-cols-2">
          {einrichtung.contacts.map((contact) => (
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400 dark:text-gray-500">
                <Icon name="user" class="h-4 w-4" />
              </span>
              <div>
                <p class="text-sm font-semibold text-gray-900 dark:text-gray-100">{contact.role}</p>
                <p class="text-sm text-gray-600 dark:text-gray-400">{contact.name}</p>
              </div>
            </div>
          ))}
        </div>
      )}

      {einrichtung.links && (
        <div class="mt-6 flex flex-wrap gap-4 border-t border-gray-100 dark:border-gray-800 pt-6">
          {einrichtung.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark"
            >
              {link.label} <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          ))}
        </div>
      )}

      </div>

    </div>
  ))
}

</div>


<div class="mt-12 rounded-2xl bg-gray-50 dark:bg-gray-800 p-6 text-center">

<p class="text-gray-700 dark:text-gray-300">
Sie benötigen die Kitaanmeldung oder ein anderes Formular?
</p>

<a
  href="/gemeinde/dokumentenportal"
  class="
    mt-3
    inline-flex
    items-center
    gap-1
    text-sm
    font-semibold
    text-primary
    hover:text-primary-dark
  "
>
  Zum Dokumentenportal <Icon name="arrow-right" class="h-4 w-4" />
</a>

</div>


</div>


</section>


<PhotoLightbox />

<script>
  import { initPhotoLightbox } from "@lib/photoLightbox";
  import { initPhotoCarousels } from "@lib/photoCarousel";

  const lightbox = initPhotoLightbox();
  if (lightbox) {
    initPhotoCarousels(lightbox.open);
  }
</script>


</BaseLayout>
