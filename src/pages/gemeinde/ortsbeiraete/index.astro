---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";

import { getPageHero } from "@lib/pageHero";

const ortsbeiraete = await getCollection("ortsbeiraete");
const hero = await getPageHero("ortsbeiraete");
const hasImage = (hero?.images?.length ?? 0) > 0;
---


<BaseLayout
  title="Ortsbeiräte"
  description="Informationen zu den Ortsbeiräten der Gemeinde Seddiner See."
>


<section class:list={["pb-12", !hasImage && "pt-6"]}>

<div class="container">


<!-- Header -->

<div class:list={["mb-10 flex flex-col gap-4", hasImage && "flex-col-reverse"]}>

<Breadcrumbs items={[{ label: "Ortsbeiräte" }]} />

<PageHero
  title={hero?.title ?? "Ortsbeiräte"}
  subtitle={hero?.subtitle ?? "Ansprechpartner in Seddin, Kähnsdorf und Neuseddin"}
  images={hero?.images ?? []}
  gradient
  fullBleed={hasImage}
/>

</div>




<!-- Cards -->


<div
  class="
    grid
    gap-8
    md:grid-cols-3
  "
>


{
  ortsbeiraete.map(item => (

<a
  href={`/gemeinde/ortsbeiraete/${item.id}`}
  class="
    group
    overflow-hidden
    rounded-3xl
    border
    border-gray-200 dark:border-gray-700
    bg-white dark:bg-gray-900
    shadow-sm
    transition
    hover:-translate-y-1
    hover:shadow-lg
  "
>


<div
  class="
    relative
    h-56
    overflow-hidden
    bg-gray-100 dark:bg-gray-800
  "
>


{item.data.images[0] && (

<img
  src={item.data.images[0].src}
  alt={item.data.title}
  class="
    h-full
    w-full
    object-cover
    transition
    duration-500
    group-hover:scale-105
  "
/>

)}


<div
  class="
    absolute
    inset-0
    bg-gradient-to-t
    from-black/50
    to-transparent
  "
></div>


</div>



<div
  class="
    p-6
  "
>


<h2
  class="
    text-xl
    font-semibold
    text-gray-900 dark:text-gray-100
  "
>
{item.data.title}
</h2>


<p
  class="
    mt-3
    text-sm
    text-gray-600 dark:text-gray-400
  "
>
Mitglieder und Ansprechpartner
</p>


</div>


</a>


  ))
}


</div>



</div>

</section>


</BaseLayout>