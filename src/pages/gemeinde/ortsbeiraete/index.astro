---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";

import { getPageHero } from "@lib/pageHero";

const ortsbeiraete = await getCollection("ortsbeiraete");
const hero = await getPageHero("ortsbeiraete");
---


<BaseLayout
  title="Ortsbeiräte"
  description="Informationen zu den Ortsbeiräten der Gemeinde Seddiner See."
>


<section class="py-12">

<div class="container">


<Breadcrumbs items={[{ label: "Ortsbeiräte" }]} />



<!-- Header -->

<div
  class="
    mb-10
  "
>

<PageHero
  title={hero?.title ?? "Ortsbeiräte"}
  subtitle={hero?.subtitle ?? "Informationen zu den Ortsbeiräten der Gemeinde Seddiner See."}
  images={hero?.images ?? []}
  gradient
/>

</div>




<!-- Cards -->


<div
  class="
    grid
    gap-8
    md:grid-cols-3
  "
>


{
  ortsbeiraete.map(item => (

<a
  href={`/gemeinde/ortsbeiraete/${item.id}`}
  class="
    group
    overflow-hidden
    rounded-3xl
    border
    border-gray-200 dark:border-gray-700
    bg-white dark:bg-gray-900
    shadow-sm
    transition
    hover:-translate-y-1
    hover:shadow-lg
  "
>


<div
  class="
    relative
    h-56
    overflow-hidden
  "
>


<img
  src={item.data.images[0].src}
  alt={item.data.title}
  class="
    h-full
    w-full
    object-cover
    transition
    duration-500
    group-hover:scale-105
  "
/>


<div
  class="
    absolute
    inset-0
    bg-gradient-to-t
    from-black/50
    to-transparent
  "
></div>


</div>



<div
  class="
    p-6
  "
>


<h2
  class="
    text-xl
    font-semibold
    text-gray-900 dark:text-gray-100
  "
>
{item.data.title}
</h2>


<p
  class="
    mt-3
    text-sm
    text-gray-600 dark:text-gray-400
  "
>
Mitglieder und Ansprechpartner
</p>


</div>


</a>


  ))
}


</div>



</div>

</section>


</BaseLayout>