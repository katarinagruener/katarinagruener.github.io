---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import BusinessCard from "@components/leben/BusinessCard.astro";
import type { IconName } from "@components/ui/Icon.astro";
import { getPageHero } from "@lib/pageHero";

const entries = (await getCollection("unternehmen")).map((entry) => entry.data);
const hero = await getPageHero("unternehmen");

function iconFor(entry: { icon?: string }): IconName {
  return (entry.icon ?? "briefcase") as IconName;
}
---


<BaseLayout
  title="Unternehmen"
  description="Ansässige Unternehmen in der Gemeinde Seddiner See"
>


<section class="py-12">


<div class="container">


<Breadcrumbs items={[{ label: "Unternehmen" }]} />

<PageHero
  title={hero?.title ?? "Unternehmen"}
  subtitle={hero?.subtitle ?? "Ansässige Unternehmen in der Gemeinde Seddiner See"}
  images={hero?.images ?? []}
  gradient
/>


<div class="mt-12 grid gap-6 md:grid-cols-2">
  {entries.map((entry) => (
    <BusinessCard
      name={entry.name}
      icon={iconFor(entry)}
      address={entry.address}
      phone={entry.phone}
      mobile={entry.mobile}
      fax={entry.fax}
      email={entry.email}
      website={entry.website}
      note={entry.note}
    />
  ))}
</div>


</div>


</section>


</BaseLayout>
