---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import BusinessCard from "@components/leben/BusinessCard.astro";
import type { IconName } from "@components/ui/Icon.astro";
import { getPageHero } from "@lib/pageHero";

const entries = (await getCollection("dienstleistungen")).map((entry) => entry.data);
const hero = await getPageHero("dienstleistungen");

const post = entries.filter((entry) => entry.type === "post");
const friseure = entries.filter((entry) => entry.type === "friseur");
const massagen = entries.filter((entry) => entry.type === "massage");
const tierpflege = entries.filter((entry) => entry.type === "tierpflege");
const versicherungen = entries.filter((entry) => entry.type === "versicherung");
const haushaltshilfe = entries.filter((entry) => entry.type === "haushaltshilfe");
const immobilien = entries.filter((entry) => entry.type === "immobilien");

const ICONS = {
  post: "post",
  friseur: "scissors",
  massage: "massage",
  tierpflege: "paw",
  versicherung: "briefcase",
  haushaltshilfe: "helping-hand",
  immobilien: "briefcase"
} as const;

function iconFor(entry: { type?: keyof typeof ICONS; icon?: string }, fallback: IconName): IconName {
  return (entry.icon ?? (entry.type ? ICONS[entry.type] : undefined) ?? fallback) as IconName;
}
---


<BaseLayout
  title="Dienstleistungen"
  description="Post, Friseure und weitere Dienstleistungen in der Gemeinde Seddiner See"
>


<section class="py-12">


<div class="container">


<Breadcrumbs items={[{ label: "Dienstleistungen" }]} />

<PageHero
  title={hero?.title ?? "Dienstleistungen"}
  subtitle={hero?.subtitle ?? "Post, Friseure und weitere Dienstleistungen in der Gemeinde Seddiner See"}
  images={hero?.images ?? []}
  gradient
/>


{post.length > 0 && (

<section class="mt-12">

<h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-gray-100">
Post
</h2>

<div class="grid gap-6 md:grid-cols-2">
  {post.map((entry) => (
    <BusinessCard
      name={entry.name}
      icon={iconFor(entry, "post")}
      address={entry.address}
      phone={entry.phone}
      mobile={entry.mobile}
      fax={entry.fax}
      email={entry.email}
      website={entry.website}
      note={entry.note}
      hours={entry.hours}
      hoursNote={entry.hoursNote}
    />
  ))}
</div>

</section>

)}


