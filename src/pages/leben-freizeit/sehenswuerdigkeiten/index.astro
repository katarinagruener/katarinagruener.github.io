---
import { getCollection } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";

import Breadcrumbs from "@components/ui/Breadcrumbs.astro";
import PageHero from "@components/ui/PageHero.astro";
import BusinessCard from "@components/leben/BusinessCard.astro";
import type { IconName } from "@components/ui/Icon.astro";
import { getPageHero } from "@lib/pageHero";

const entries = (await getCollection("sehenswuerdigkeiten")).map((entry) => ({ ...entry.data, slug: entry.id }));
const hero = await getPageHero("sehenswuerdigkeiten");
const hasImage = (hero?.images?.length ?? 0) > 0;

function iconFor(entry: { icon?: string }): IconName {
  return (entry.icon ?? "signpost") as IconName;
}
---


<BaseLayout
  title="Sehenswürdigkeiten & Freizeitorte"
  description="Ausflugsziele, Sehenswürdigkeiten und Freizeitorte in der Gemeinde Seddiner See"
>


<section class:list={["pb-12", !hasImage && "pt-6"]}>


<div class="container">







<div class:list={["flex flex-col gap-4", hasImage && "flex-col-reverse"]}>

<Breadcrumbs items={[{ label: "Sehenswürdigkeiten & Freizeitorte" }]} />

<PageHero
  title={hero?.title ?? "Sehenswürdigkeiten & Freizeitorte"}
  subtitle={hero?.subtitle ?? "Ausflugsziele rund um den Seddiner See"}
  images={hero?.images ?? []}
  gradient
  fullBleed={hasImage}
/>

</div>


<h2 class="sr-only">Alle Einträge</h2>

<div class="mt-8 grid gap-6 md:grid-cols-2">
  {entries.map((entry) => (
    <BusinessCard {...entry} icon={iconFor(entry)} />
  ))}
</div>


</div>


</section>


</BaseLayout>
